API_APP_NAME=Enterprise AI Operations Assistant
API_ENVIRONMENT=production
API_VERSION=0.1.0
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

STREAMLIT_API_BASE_URL=http://fastapi:8000
STREAMLIT_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

AI_DASHBOARD_SEED_DIR=data/seed
LOG_LEVEL=INFO
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_EMBEDDING_BATCH_SIZE=64
OPENAI_TEMPERATURE=0
AGENT_RETRIEVAL_LIMIT=8
AGENT_TOOL_MAX_ATTEMPTS=3

MCP_CLIENT_MODE=http
MCP_CLIENT_TIMEOUT_SECONDS=15
MCP_ALLOW_LOCAL_FALLBACK=false
MCP_TRANSPORT=http
MCP_HOST=0.0.0.0
TICKET_MCP_PORT=8101
DOCUMENT_MCP_PORT=8102
LOG_MCP_PORT=8103
TICKET_MCP_URL=http://ticket-mcp:8101/mcp
DOCUMENT_MCP_URL=http://document-mcp:8102/mcp
LOG_MCP_URL=http://log-mcp:8103/mcp

MONGODB_IMAGE=mongo:8.0
MONGODB_URI=mongodb://mongodb:27017
MONGODB_HOST_PORT=27017
MONGODB_DATABASE=enterprise_ai_ops
MONGODB_DOCUMENTS_COLLECTION=project_documents
MONGODB_CHUNKS_COLLECTION=document_chunks
MONGODB_VECTOR_INDEX=document_vector_index
MONGODB_VECTOR_SEARCH_MODE=auto
MONGODB_ALLOW_KEYWORD_FALLBACK=true
MONGODB_CREATE_VECTOR_INDEX=true
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_REQUIRE_EMBEDDINGS=false
